{
  "name": "Metju.Chord",
  "version": "1.0.0",
  "private": true,
  "description": "A chord instrument and song sketchpad in the browser: seven chord pads, an 8-way stick, sections, parts and effects.",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "vitest run",
    "levels": "esbuild scripts/levels.ts --bundle --platform=node --packages=external --format=cjs --log-level=warning --outfile=.levels/run.cjs && node .levels/run.cjs"
  },
  "keywords": [
    "music",
    "chords",
    "sequencer",
    "tone.js",
    "react",
    "pwa"
  ],
  "author": "Matěj Samler (metjuperry)",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.2",
    "css-loader": "^7.1.2",
    "esbuild": "^0.28.2",
    "html-webpack-plugin": "^5.6.4",
    "playwright-core": "^1.56.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "homepage": "https://metjuperry.github.io/Metju.Chord/",
  "repository": {
    "type": "git",
    "url": "https://github.com/metjuperry/Metju.Chord.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
